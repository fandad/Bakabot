<Window
    x:Class="Bakabot.Views.Dialogs.CreateInstanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="创建机器人实例"
    Width="560"
    Height="760"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border
        CornerRadius="12"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        Margin="16"
        Padding="0">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.15" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ 标题栏 ═══ -->
            <DockPanel Grid.Row="0" Margin="24,24,24,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <ui:Button
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    Appearance="Transparent"
                    CornerRadius="6"
                    Padding="8,4"
                    Click="Close_Click" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Bot24" FontSize="24" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock
                        x:Name="DialogTitle"
                        FontSize="20"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="创建新实例" />
                </StackPanel>
            </DockPanel>

            <!-- ═══ 表单滚动区 ═══ -->
            <ScrollViewer
                Grid.Row="1"
                Margin="24,0,24,0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="0,0,0,16">

                    <TextBlock Text="实例名称" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ui:TextBox
                        x:Name="InstanceNameBox"
                        Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="例如: MyBot01"
                        Margin="0,0,0,24" />

                    <!-- ─── 服务器配置 ─── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Server24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="服务器配置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 提示行：仅端口上方显示，左右两列为占位保持对齐 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="若服务器没有写则默认25565" FontSize="10" Opacity="0.45" TextWrapping="Wrap" Margin="0,0,0,4" />

                        <!-- 标签行 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="服务器地址 (MC_HOST)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="端口 (MC_PORT)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="版本 (MC_VERSION)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />

                        <!-- 输入行 -->
                        <ui:TextBox Grid.Row="2" Grid.Column="0" Text="{Binding McHost, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="myarc.fun" />
                        <ui:TextBox Grid.Row="2" Grid.Column="2" Text="{Binding McPort, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="25565" />
                        <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Versions}" Text="{Binding McVersion, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
                    </Grid>

                    <TextBlock Text="用户名 (MC_USERNAME)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding McUsername, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="用户名/邮箱（第三方登录填邮箱）"
                        Margin="0,0,0,12" />

                    <TextBlock Text="认证方式 (MC_AUTH_TYPE)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ComboBox
                        ItemsSource="{Binding AuthTypes}"
                        SelectedItem="{Binding McAuthType}"
                        Margin="0,0,0,12" />
                    <TextBlock Text="💡 选择 yggdrasil 第三方登录时，上方「用户名」填邮箱，「登录密码」填皮肤站密码" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="认证服务器地址 (AUTH_SERVER_URL，第三方登录时填写)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding AuthServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="https://littleskin.cn/api/yggdrasil"
                                Margin="0,0,0,12" />

                    <TextBlock Text="注册链接 (REGISTER_URL，可选)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding RegisterUrl, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="https://littleskin.cn/auth/register"
                                Margin="0,0,0,12" />

                    <TextBlock Text="登录密码 (MC_LOGIN_PASSWORD, 选填)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:PasswordBox
                        x:Name="PasswordField"
                        Margin="0,0,0,12"
                        PasswordChanged="PasswordField_Changed" />

                    <TextBlock Text="主人名称 (多个用逗号分隔，机器人能分别认出每位主人并单独回应)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding McOwnerName, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="_FENTAI_,Steve,Alex"
                        Margin="0,0,0,32" />

                    <!-- ─── AI 配置 ─── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <!-- ★ 修复：将可能不存在的 BrainBackground20 替换为基础的 Lightbulb24 -->
                        <ui:SymbolIcon Symbol="Lightbulb24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="AI 配置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="API Key (LLM_API_KEY)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding LlmApiKey, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="ark-..."
                        Margin="0,0,0,12" />

                    <TextBlock Text="API URL (LLM_API_URL)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding LlmApiUrl, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="https://..."
                        Margin="0,0,0,12" />

                    <!-- 💡 模型 ID 格式常驻提示 -->
                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                            Background="#33FF9500" BorderBrush="#FFFF9500" BorderThickness="1.5">
                        <TextBlock
                            Text="⚠️ 模型 ID 格式：大小写字母、数字、连字符(-)、点(.)、下划线(_)、斜杠(/)（如 minimaxai/minimax-m3）、冒号(:)和 @，不能包含空格"
                            FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FFFF9500" />
                    </Border>

                    <TextBlock Text="模型名称 (LLM_MODEL)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding LlmModel, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="doubao-..."
                        Margin="0,0,0,12" />

                    <!-- 💡 视觉 API 为额外功能，不填一般不影响基础功能 -->
                                        <Border CornerRadius="8" Padding="12,10" Margin="0,4,0,12"
                                                Background="#33FF9500" BorderBrush="#FFFF9500" BorderThickness="1.5">
                                            <TextBlock
                                                Text="💡 以下视觉 API 配置为额外功能（仅用于“看看/截图”看图指令），不填一般不影响基础功能使用。"
                                                FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FFFF9500" />
                                        </Border>
                    
                    <!-- 💡 视觉模型 ID 格式常驻提示（留空则禁用看图） -->
                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                            Background="#33FF9500" BorderBrush="#FFFF9500" BorderThickness="1.5">
                        <TextBlock
                            Text="⚠️ 视觉模型 ID 同样支持大小写字母、数字、连字符(-)、点(.)、下划线(_)、斜杠(/)（如 minimaxai/minimax-m3）、冒号(:)和 @，不能包含空格；留空则禁用看图功能"
                            FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FFFF9500" />
                    </Border>

                    <TextBlock Text="视觉看图模型 (VISION_MODEL)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding VisionModel, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="doubao-seed-evolving-latest-version（留空则禁用看图）"
                        Margin="0,0,0,4" />
                    <TextBlock
                        Text="机器人收到“看看/截图”指令后会截取第一视角画面，交给该视觉模型描述眼前场景。需支持图片输入的多模态模型（deepseek-v4-flash 不支持）。"
                        FontSize="11" Opacity="0.45" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="视觉 API URL (VISION_API_URL)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding VisionApiUrl, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="留空则复用上方 LLM_API_URL"
                        Margin="0,0,0,12" />

                    <TextBlock Text="视觉 API Key (VISION_API_KEY)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding VisionApiKey, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="留空则复用上方 LLM_API_KEY"
                        Margin="0,0,0,12" />

                    <TextBlock Text="对话模式 (whisper=/tell 私信, msg=/msg 私信, public=公屏)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ComboBox
                        ItemsSource="{Binding TellModes}"
                        SelectedItem="{Binding TellMode}"
                        Margin="0,0,0,12" />
                    <TextBlock Text="触发模式 (TRIGGER_MODE)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ComboBox
                        ItemsSource="{Binding TriggerModes}"
                        SelectedItem="{Binding TriggerMode}"
                        Margin="0,0,0,4" />
                    <TextBlock
                        Text="hybrid＝主人有求必应＋他人说关键词才回复；owner_only＝只听主人；keyword_only＝任何人说关键词才回复"
                        FontSize="11" Opacity="0.45" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="触发关键词 (CHAT_TRIGGER)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <ui:TextBox
                        Text="{Binding ChatTrigger, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="他人发言包含此词才会触发机器人（owner_only 模式下无需填写）"
                        Margin="0,0,0,12" />


                    <TextBlock Text="AI 风格提示词 (AI_STYLE_PROMPT)" FontSize="12" Opacity="0.6" Margin="0,0,0,6" />
                    <!-- ★ 修复：多行文本框还原为原生 TextBox，避免 ui:TextBox 不支持多行属性导致崩溃 -->
                    <TextBox
                        Text="{Binding AiStylePrompt, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="80"
                        MaxHeight="120"
                        VerticalScrollBarVisibility="Auto"
                        Padding="10,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,32">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- ─── 行为开关 ─── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="行为设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoDefendEnabled}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动防御" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="AUTO_DEFEND_ENABLED" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoAcceptTpa}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="接受 TPA 传送请求" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="INSTINCT_TP_ACCEPT：收到传送请求时自动 /tpaccept" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="16,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding TpaOwnerOnly}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="仅接受主人 TPA" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="关闭后任何人都能传送到机器人身边，请慎用" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Margin="16,0,0,8">
                            <TextBlock Text="TPA 触发关键词（尽量写全，逗号分隔）" FontSize="12" Opacity="0.6" Margin="0,0,0,4" />
                            <ui:TextBox
                                Text="{Binding TpaAcceptTrigger, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="例如：请求传送到你这里,has requested to teleport to you"
                                Margin="0,0,0,4" />
                            <TextBlock Text="填服务器接到 TPA 请求时显示的消息，尽量写全（含玩家名和完整句子），多个用逗号分隔；留空则只识别默认格式" FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
                        </StackPanel>

                        <DockPanel Margin="0,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoLogin}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动登录" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="第三方登录/无login服务器(正版)请关闭防卡住" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding DeathBack}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="死亡后自动 /back" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="INSTINCT_DEATH_BACK" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstinctAutoEat}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动进食" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="INSTINCT_AUTO_EAT" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstinctAutoTool}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动切换工具" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="INSTINCT_AUTO_TOOL" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding InstinctAutoDump}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动丢弃垃圾" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="INSTINCT_AUTO_DUMP" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoAcceptResourcePack}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动接受资源包" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="AUTO_ACCEPT_RESOURCE_PACK" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SuppressActionChat}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="屏蔽行动公屏播报" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="只屏蔽游戏内公屏播报，发往 QQ 的行动消息不受影响" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ForbidMining}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="禁止挖掘" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="FORBID_MINING，开启后机器人禁用一切挖掘功能（保存后即时生效，无需重启）" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartupGreeting}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="进服问候语" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="INSTINCT_STARTUP_GREETING：进服时是否发送“主人好，底层框架已启动，等待指令！”" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding DebugMode}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="调试模式" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="DEBUG_MODE" FontSize="11" Opacity="0.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ 底部操作栏 ═══ -->
            <Border
                Grid.Row="2"
                Padding="24,16"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="0,0,12,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">

                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        x:Name="ErrorLabel"
                        Text="{Binding ErrorMessage}"
                        Foreground="#FF5252"
                        FontSize="12"
                        VerticalAlignment="Center"
                        MaxWidth="260"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <ui:Button
                            Content="取消"
                            Appearance="Secondary"
                            CornerRadius="6"
                            Padding="20,8"
                            Margin="0,0,12,0"
                            Click="Close_Click" />

                        <ui:Button
                            x:Name="SaveButton"
                            Content="保存并创建"
                            Icon="{ui:SymbolIcon Save24}"
                            Appearance="Info"
                            CornerRadius="6"
                            Padding="20,8"
                            Command="{Binding SaveCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
